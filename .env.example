# Get one at https://app.mem0.ai  (free Hobby tier: ~10k memories/mo)
MEM0_API_KEY=m0-xxxxxxxxxxxxxxxx
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Optional overrides
MEDLOG_DB_PATH=medlog.db
MEDLOG_CHAT_MODEL=claude-sonnet-5
MEDLOG_REASONING_MODEL=claude-opus-5

# Public-demo switches (leave unset for normal local use)
# MEDLOG_DEMO=1            serve Claude-derived artifacts from demo_cache/, no Anthropic key needed
# MEDLOG_SINGLE_PROCESS=1  UI dispatches into FastAPI in-process instead of over HTTP
